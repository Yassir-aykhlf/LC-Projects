# Local development database. Production is reached only through ./ops/,
# never through DATABASE_URL. See ops/README.md.
#
# scripts/_env.sh already exports this, so you normally do not need a .env
# file at all. It is here for tools that expect one.
DATABASE_URL=postgresql+psycopg://slotwise:slotwise@127.0.0.1:5432/slotwise_local
